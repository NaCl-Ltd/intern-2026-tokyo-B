<% provide(:title, "Log in") %>
<h1>t('shared.label.sign_in')</h1>

<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <%= form_with(url: login_path, scope: :session) do |f| %>

      <%= f.label :email %>
      <%= f.email_field :email, class: 'form-control' %>

      <%= f.label :password %>
      <%= link_to "(t('shared.label.forgot_your_password'))", new_password_reset_path %>
      <%= f.password_field :password, class: 'form-control' %>

      <%= f.label :remember_me, class: "checkbox inline" do %>
        <%= f.check_box :remember_me %>
        <span>t('shared.label.remember_me')</span>
      <% end %>

      <%= f.submit t('shared.label.sign_in'), class: "btn btn-primary" %>
    <% end %>

    <p>新しい参加者ですか? <%= link_to t('shared.label.join_now'), signup_path %></p>
  </div>
</div>
