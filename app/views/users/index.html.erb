<% provide(:title, 'All users') %>
<h1><%= t('shared.label.all_users') %></h1>
<%= search_form_for @q do |f| %>
  <%= f.label :name_or_email_cont , "名前またはメールで検索" %>
  <%= f.search_field :name_or_email_cont, class: "form-control", placeholder: "キーワード" %>
  <%= f.submit "検索",class: "btn btn-primary" %>
<% end %>

<%= will_paginate %>

<ul class="users">
  <% if @users.present? %>
    <%= render @users %>
  <% else %>
    <h2>該当するユーザーは見つかりませんでした</h2>
  <% end %>
</ul>

<%= will_paginate %>
