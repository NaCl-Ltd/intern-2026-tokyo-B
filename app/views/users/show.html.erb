<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <h1>
        <%= gravatar_for @user %>
        <%= @user.name %>

        <% if @user.nickname.present? %>
          <br>
          <small class="text-muted" style="font-weight: normal;">@<%= @user.nickname %></small>
        <% end %>
      </h1>
    </section>

    <section class="stats">
      <%= render 'shared/stats' %>
    </section>
  </aside>

  <div class="col-md-8">
    <%= render 'follow_form' if logged_in? %>
    <% if @user.microposts.any? %>
      <h3>Microposts (<%= @user.microposts.count %>)</h3>

      <% if @pinned_micropost && (params[:page].nil? || params[:page] == "1") %>
        <div class="pinned-micropost" style="border: 2px solid #5bc0de; padding: 10px; margin-bottom: 20px; border-radius: 5px;">
          <span style="display: inline-block; background-color: #5bc0de; color: white; padding: 3px 8px; border-radius: 3px; margin-bottom: 10px; font-weight: bold; font-size: 12px;">
            📌 固定されたマイクロポスト
          </span>
          <ol class="microposts" style="margin-bottom: 0;">
            <%= render @pinned_micropost %>
          </ol>
        </div>
      <% end %>

      <ol class="microposts">
        <%= render @microposts %>
      </ol>
      <%= will_paginate @microposts %>
    <% end %>
  </div>
</div>
