<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <h1>
        <%= gravatar_for @user %>
        <%= @user.name %>

        <% if @user.nickname.present? %>
          <br>
          <small class="text-muted" style="font-weight: normal;">@<%= @user.nickname %></small>
        <% end %>
      </h1>
    </section>

    <section class="stats">
      <%= render 'shared/stats' %>
    </section>
  </aside>

  <div class="col-md-8">
    <%= render 'follow_form' if logged_in? %>
    <%= form_with url: "/users/#{@user.id}", method: :get do |f| %>
        <%= f.label "内容検索" %>
      <%= f.search_field :content, value: params[:content], placeholder: "ex)rem" %>
        <%= f.submit "検索", class: "btn btn-secondary" %>
    <% end %>
    <% if @user.microposts.any? %>
      <h3><%= t('shared.label.micropost') %> (<%= @user.microposts.count %>)</h3>
      <ol class="microposts">
        <% if @microposts.count > 0 %>
          <%= render @microposts %>
        <% else %>
          <section class="nothing_microposts">
            Nothing Microposts
          </section>
        <% end %>
      </ol>
      <%= will_paginate @microposts %>
    <% end %>
  </div>
</div>