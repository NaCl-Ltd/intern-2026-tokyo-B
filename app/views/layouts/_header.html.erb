<header class="navbar navbar-fixed-top navbar-inverse">
  <div class="container">
    <%= image_tag("ruby.png", id: "logo_icon", alt: "Ruby logo", width: "30px") %>
    <%= link_to t('shared.label.app_name'), root_path, id: "logo" %>
    <nav>
      <div class="navbar-header">
        <button id="hamburger" type="button" class="navbar-toggle collapsed">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
      </div>
      <ul id="navbar-menu"
          class="nav navbar-nav navbar-right collapse navbar-collapse">
        <li><%= link_to t('shared.label.home'), root_path %></li>
        <li><%= link_to t('shared.label.help'), help_path %></li>
        <% if logged_in? %>
          <li><%= link_to t('shared.label.all_users'), users_path %></li>

          <% recent_count = current_user.recent_following_microposts.count %>
          <li>
            <%= link_to recent_path do %>
              New <%= "(#{recent_count})" if recent_count > 0 %>
            <% end %>
          </li>

          <% bookmark_count = current_user.bookmarked_microposts.count %>
          <li>
            <%= link_to bookmark_show_path do %>
              Bookmark <%= "(#{bookmark_count})" if bookmark_count > 0 %>
            <% end %>
          </li>

          <li class="dropdown">
            <a href="#" id="account" class="dropdown-toggle">
              <%= t('shared.label.account') %> <b class="caret"></b>
            </a>
            <ul id="dropdown-menu" class="dropdown-menu">
              <li><%= link_to t('shared.label.profile'), current_user %></li>
              <li><%= link_to t('shared.label.setting'), edit_user_path(current_user) %></li>
              <li class="divider"></li>
              <li>
                <%= link_to t('shared.label.signed_out'), logout_path, data: { "turbo-method": :delete } %>
              </li>
            </ul>
          </li>
        <% else %>
          <li><%= link_to t('shared.label.sign_in'), login_path %></li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
